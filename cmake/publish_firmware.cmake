if(NOT EXISTS "${SOURCE_FILE}" OR IS_DIRECTORY "${SOURCE_FILE}")
    message(FATAL_ERROR "Firmware binary is missing: ${SOURCE_FILE}")
endif()
if(NOT IS_DIRECTORY "${DESTINATION_DIR}")
    message(FATAL_ERROR "Firmware destination is unavailable: ${DESTINATION_DIR}")
endif()
if(NOT FIRMWARE_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
   OR NOT FIRMWARE_PROJECT MATCHES "^[A-Za-z0-9_-]+$"
   OR NOT FIRMWARE_TARGET MATCHES "^[A-Za-z0-9_-]+$"
   OR NOT FIRMWARE_ORIGIN MATCHES "^https?://[A-Za-z0-9.:-]+$")
    message(FATAL_ERROR "Invalid publication metadata")
endif()

if(NOT DEFINED FIRMWARE_URL_PATH)
    set(FIRMWARE_URL_PATH "")
endif()
if(NOT FIRMWARE_URL_PATH MATCHES "^(/[A-Za-z0-9_-]+)*$")
    message(FATAL_ERROR "Invalid FIRMWARE_URL_PATH; use empty or /directory/subdirectory without trailing slash")
endif()

file(SHA256 "${SOURCE_FILE}" source_hash)
file(SIZE "${SOURCE_FILE}" source_size)
set(versioned_name "${FIRMWARE_PROJECT}-${FIRMWARE_VERSION}.bin")
set(versioned "${DESTINATION_DIR}${versioned_name}")

function(copy_verified destination)
    set(temporary "${destination}.uploading")
    file(COPY_FILE "${SOURCE_FILE}" "${temporary}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Cannot copy firmware: ${result}")
    endif()
    file(SHA256 "${temporary}" copied_hash)
    file(SIZE "${temporary}" copied_size)
    if(NOT copied_hash STREQUAL source_hash OR NOT copied_size EQUAL source_size)
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Copied firmware size/hash mismatch")
    endif()
    file(RENAME "${temporary}" "${destination}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Cannot publish firmware: ${result}")
    endif()
endfunction()

if(EXISTS "${versioned}")
    file(SHA256 "${versioned}" existing_hash)
    file(SIZE "${versioned}" existing_size)
    if(NOT existing_hash STREQUAL source_hash OR NOT existing_size EQUAL source_size)
        message(FATAL_ERROR "Immutable release already exists with different bytes: ${versioned}. Bump version.")
    endif()
else()
    copy_verified("${versioned}")
endif()

# The compatibility name is not used by manifest-aware devices.
copy_verified("${DESTINATION_DIR}${FIRMWARE_PROJECT}.bin")
set(manifest "${DESTINATION_DIR}firmware.json")
file(WRITE "${manifest}.uploading"
    "{\n  \"project\": \"${FIRMWARE_PROJECT}\",\n  \"target\": \"${FIRMWARE_TARGET}\",\n  \"version\": \"${FIRMWARE_VERSION}\",\n  \"url\": \"${FIRMWARE_ORIGIN}${FIRMWARE_URL_PATH}/${versioned_name}\",\n  \"size\": ${source_size},\n  \"sha256\": \"${source_hash}\",\n  \"notes\": \"Manifest-based update availability; manual installation only.\"\n}\n")
file(RENAME "${manifest}.uploading" "${manifest}" RESULT result)
if(NOT result STREQUAL "0")
    file(REMOVE "${manifest}.uploading")
    message(FATAL_ERROR "Cannot publish manifest: ${result}")
endif()
message(STATUS "Published ${versioned_name}, ${source_size} bytes, SHA256 ${source_hash}; firmware.json committed last")
