menu "OTA Suite web interface"
    config OTA_SUITE_WEB_PASSWORD
        string "Initial web login password"
        default "ebctester"
        help
            Initial admin password for login and settings confirmation.
            Use 8-63 printable ASCII characters without leading or trailing
            spaces. A password saved through
            Login Settings takes precedence and survives firmware updates.
            This does not change the setup access point password.
    config OTA_SUITE_WEB_SETTINGS_REQUIRE_PASSWORD
        bool "Require admin password when saving web settings"
        default y
        help
            Require the configured web admin password for every settings save,
            even when browser login is disabled, in addition to a CSRF token
            and a valid session when login is enabled. Extensions
            must use web_interface_authorize_settings_request for settings.
            This does not affect test controls, uploads or OTA actions.
    config OTA_SUITE_WEB_SD_LANGUAGES
        bool "Enable optional SD language provider"
        default n
        help
            The consuming application must register authenticated
            /api/i18n/languages and /api/i18n/language endpoints before startup.
            Without this option the built-in English and German UI is standalone.
    config OTA_SUITE_WEB_PRIMARY_TABS
        string "Tabs in the primary navigation section (empty disables sections)"
        default ""
        help
            Comma-separated tab ids for the Batterietester section.
            Other tabs appear under Verwaltung.
    config OTA_SUITE_WEB_ACTIVITY_URL
        string "Optional frame status endpoint for the header activity LED"
        default ""
        help
            Same-origin endpoint returning link.connected, link.framesOk and
            link.ageMs. Empty disables the activity indicator.
    config OTA_SUITE_WEB_TAB_ORDER
        string "Web interface tab order"
        default "overview,updates,settings"
        help
            Comma-separated tab ids in display order. Built-in tabs are
            overview, updates and settings; extension tabs use their registered
            id (for example sd-card). Unlisted tabs are appended. The first
            listed tab is opened when the page loads.
endmenu
