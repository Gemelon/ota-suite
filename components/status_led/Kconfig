menu "OTA Suite status LED"
    config OTA_SUITE_STATUS_LED_ENABLE
        bool "Enable the OTA status LED"
        default n
        help
            Enable the optional WS2812 RGB status indicator.
    config OTA_SUITE_LED_GPIO
        int "Onboard WS2812 RGB LED GPIO"
        range 0 48
        default 48
        help
            ESP32-S3-DevKitC-1 normally uses GPIO48.
            Some board revisions use GPIO38. Check your board schematic.
endmenu
